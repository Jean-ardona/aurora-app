# Base URL for the frame images (504 JPGs)
# Development: leave empty → serves from /public/frames/ locally
# Production: set to your CDN/R2 bucket public URL (no trailing slash)
#
# Example (Cloudflare R2):
# NEXT_PUBLIC_FRAMES_URL=https://pub-XXXXXXXXXXXXXXXX.r2.dev
#
# Example (any other CDN):
# NEXT_PUBLIC_FRAMES_URL=https://cdn.yourdomain.com/aurora-frames
NEXT_PUBLIC_FRAMES_URL=
